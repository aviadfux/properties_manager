# Copy to .env (never committed) or run:  uv run python -m app.cli init-env
# In production these come from the host's secret manager, not from a file.

ENVIRONMENT=development

# The API connects as pm_app: a role that does not own the tables, so row-level security applies to it.
DATABASE_URL=postgresql+psycopg://pm_app:pm_local_app@localhost:5432/pm_dev
# Migrations connect as the owner. Only `app.cli` and Alembic use this.
MIGRATION_DATABASE_URL=postgresql+psycopg://pm_owner:pm_local_dev@localhost:5432/pm_dev

# Generate with:  uv run python -m app.cli generate-keys
# Several keys, comma-separated, for rotation: the first encrypts, all of them decrypt.
FIELD_ENCRYPTION_KEYS=
BLIND_INDEX_KEY=
